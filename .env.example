# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_secret

# Autenticación App
APP_USERNAME=your_admin_user
APP_PASSWORD=replace_with_a_unique_password
# Generate independently of APP_PASSWORD with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_COOKIE_SECRET=generate_a_random_secret_of_at_least_32_characters
AUTH_REMEMBER_DAYS=30

# Streamlit Configuration
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_LOGGER_LEVEL=info

# Python
PYTHONUNBUFFERED=1

# Microsoft 365 - Descarga automática de imágenes Luxoptica
M365_TENANT_ID=your_tenant_id_here
M365_CLIENT_ID=your_app_client_id_here
M365_CLIENT_SECRET=your_app_client_secret_here
M365_MAILBOX=images@diagonaleyewear.com
# Raiz comun de fotografias para app, Graph y Kering; migrar antes del corte.
IMAGE_REPOSITORY_ROOT=/app/repo/images
# Para ejecucion sin Compose, usar la ruta persistente absoluta del equipo.
IMAGE_REPOSITORY_HOST_ROOT=./image_repository

# Luxoptica - Subida automática de solicitudes
LUXOPTICA_URL=https://portal.luxottica.com/
LUXOPTICA_USERNAME=your_luxoptica_username
LUXOPTICA_PASSWORD=your_luxoptica_password
LUXOPTICA_REQUEST_EMAIL=images@diagonaleyewear.com
