# STAGING ONLY. Do not load into active production services.
# Bind existing /mnt/cloud-imagenes to /nas; no new export or mount.
IMAGE_REPOSITORY_STAGING_ROOT=/nas/staging
IMAGE_REPOSITORY_STAGING_MOUNT_ROOT=/nas
IMAGE_REPOSITORY_ROOT=/nas/staging/images
IMAGE_REPOSITORY_NFS_SOURCE=192.168.1.32:/volume1/cloud-imagenes
IMAGE_REPOSITORY_STATE_ROOT=/staging/state
IMAGE_REPOSITORY_BACKUP_ROOT=/nas/staging/backups
IMAGE_REPOSITORY_BACKUP_NFS_SOURCE=192.168.1.32:/volume1/cloud-imagenes
IMAGE_REPOSITORY_WORK_ROOT=/nas/staging/work
IMAGE_REPOSITORY_WORK_MOUNT_ROOT=/nas
IMAGE_REPOSITORY_WORK_NFS_SOURCE=192.168.1.32:/volume1/cloud-imagenes
IMAGE_REPOSITORY_WORK_RESERVE_BYTES=2147483648
GRAPH_IMAGE_MAX_ARCHIVE_BYTES=8589934592
GRAPH_IMAGE_MAX_ENTRY_BYTES=31457280
GRAPH_IMAGE_MAX_ZIP_ENTRIES=50000
# LOCAL state; SQLite/history never on NAS.
KERING_DATA_ROOT=/staging/state/kering
PROCESS_ACTIVITY_PATH=/staging/state/process_activity.sqlite3
# The staging backup shares the NAS failure domain. Production needs an independent backup.
# Compose interpolation only: set BOTH to the same verified capture RUN if using source/RUN.
