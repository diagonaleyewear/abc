    {
      "parameters": {
        "jsCode": "// Verificar que tenemos texto\nconst texto = $json.data;\nif (!texto) {\n  throw new Error(\"No se encontró la propiedad 'data' con el contenido del archivo.\");\n}\n\n// Dividir el contenido por líneas\nconst lineas = texto.split('\\n');\n\n// Eliminar las dos primeras líneas\nconst resultado = lineas.slice(2).join('\\n');\n\n// Devolver el nuevo texto en el mismo campo 'data'\nreturn [{\n  json: {\n    data: resultado\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1616,
        -128
      ],
      "id": "4af7885f-3553-4d25-8eab-f88fee2daae4",
      "name": "Eliminar cabecera"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b774c52f-22ec-4dfb-a1ed-24199648b448",
              "name": "name",
              "value": "={{ $('Adjunto').item.json.name }}",
              "type": "string"
            },
            {
              "id": "609b2a51-cb26-431a-add6-d28f94364b8e",
              "name": "data",
              "value": "={{ $json.data }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1776,
        -128
      ],
      "id": "3dd6d10c-80b3-4b5c-a087-9265f297f257",
      "name": "Editor Campos1"
    },
    {
      "parameters": {
        "jsCode": "const texto = $json.data;\nconst filename = $json.filename || $json.name || \"\";\n\nif (!texto || !filename) {\n  throw new Error(\"Faltan los campos 'data' (texto del fichero) o 'filename'/'name'.\");\n}\n\n// Separar líneas\nconst lineas = texto\n  .replace(/\\\\r\\\\n/g, '\\n')\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\r/g, '\\n')\n  .split('\\n')\n  .filter(l => l.trim().length > 0);\n\n// Extraer albarán y fecha\nconst albaranMatch = filename.match(/SHIP_(\\d+)_/);\nconst fechaMatch = filename.match(/_(\\d{8})_/);\nif (!albaranMatch || !fechaMatch) {\n  throw new Error(\"Nombre de fichero inválido.\");\n}\n\nconst albaran = albaranMatch[1];\nconst fechaRaw = fechaMatch[1];\nconst yyyy = fechaRaw.slice(0, 4);\nconst mm = fechaRaw.slice(4, 6);\nconst dd = fechaRaw.slice(6, 8);\nconst fechaCompra = `${dd}/${mm}/${yyyy}`;\n\n// Calcular fecha estimada de entrega (fecha + 2 días)\nconst fechaEntregaObj = new Date(`${yyyy}-${mm}-${dd}`);\nfechaEntregaObj.setDate(fechaEntregaObj.getDate() + 2);\nconst fechaEntrega = fechaEntregaObj.toLocaleDateString('es-ES', {\n  day: '2-digit', month: '2-digit', year: 'numeric'\n});\n\n// Recoger IDs únicos y productos\nconst idsCliente = new Set();\nconst productos = [];\n\nfor (const linea of lineas) {\n  const id_raw = linea.substring(94, 106).trim();\n  const id_cliente = id_raw.substring(1, 11); // quitar primer carácter, dejar 10\n\n  const barcode = linea.substring(149, 162).trim();\n  const cantidad_str = linea.substring(348, 354);\n  const cantidad = parseInt(cantidad_str, 10).toString();\n\n  const pvo_raw = linea.substring(357, 365).trim();\n  const pvo_euros = parseInt(pvo_raw, 10) / 100000; // convertir a euros\n  const pvo_formateado = pvo_euros.toFixed(6).replace('.', ',').padStart(9, '0');\n\n  idsCliente.add(id_cliente);\n\n  productos.push({\n    Proveedor: \"MARCOLIN IBERICA, S.A.\",\n    \"Referencia Proveedor\": `ALB${albaran}`, // se completa más abajo\n    \"Fecha Compra\": fechaCompra,\n    \"Fecha Estimada Entrega\": fechaEntrega,\n    Barcode: barcode,\n    Descripción: \"\",\n    PVO: pvo_formateado,\n    Descuento: \"20\",\n    Cantidad: cantidad\n  });\n}\n\n// Agrupar por EAN y sumar cantidades\nconst agrupados = {};\nfor (const item of productos) {\n  const ean = item.Barcode;\n  if (!agrupados[ean]) {\n    agrupados[ean] = { ...item };\n    agrupados[ean].Cantidad = parseInt(item.Cantidad, 10);\n  } else {\n    agrupados[ean].Cantidad += parseInt(item.Cantidad, 10);\n  }\n}\n\n// Completar Referencia Proveedor\nconst refCompleta = `ALB${albaran} | ${Array.from(idsCliente).join(' | ')} | MORE`;\nconst resultadoFinal = Object.values(agrupados).map(prod => ({\n  ...prod,\n  \"Referencia Proveedor\": refCompleta,\n  Cantidad: prod.Cantidad.toString()\n}));\n\nreturn resultadoFinal.map(r => ({ json: r }));\n"
      },
