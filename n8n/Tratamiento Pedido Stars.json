    {
      "parameters": {
        "jsCode": "// Crear un conjunto (Set) para almacenar valores únicos de Referencia Proveedor\nlet referenciasUnicas = new Set();\n\n// Recorrer todos los registros y limpiar los valores\nitems.forEach(item => {\n    let referenciaLimpia = item.json[\"Referencia Proveedor\"].replace(/\\D/g, '');\n    referenciasUnicas.add(referenciaLimpia);\n});\n\n// Obtener el valor de \"Numero Albaran\" del primer item\nlet numeroAlbaran = items[0].json[\"Numero Albaran\"] || \"\";\n\n// Construir el valor final\nlet referenciaFinal = \"ALB\" + numeroAlbaran + \" | \" + Array.from(referenciasUnicas).join(\" | \") + \" | STARS\";\n\n// Asignar el mismo valor final a todos los registros\nreturn items.map(item => {\n    return {\n        json: {\n            ...item.json,\n            \"Referencia Proveedor\": referenciaFinal\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -384,
        240
      ],
      "id": "a7bf2519-a488-4b36-ac61-d87bc3cdaceb",
      "name": "Referencia Proveedor"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    // Convertir \"Fecha Estimada Entrega\" de DD/MM/YYYY a un objeto Date\n    let fechaEntregaParts = item.json[\"Fecha Estimada Entrega\"].split(\"/\");\n    let fechaEntrega = new Date(`${fechaEntregaParts[2]}-${fechaEntregaParts[1]}-${fechaEntregaParts[0]}`);\n\n    // Sumar 3 días\n    fechaEntrega.setDate(fechaEntrega.getDate() + 3);\n\n    // Formatear la nueva fecha a DD/MM/YYYY\n    let nuevaFechaEntrega = fechaEntrega.toLocaleDateString(\"es-ES\", {\n        day: \"2-digit\",\n        month: \"2-digit\",\n        year: \"numeric\"\n    });\n\n    // Devolver los datos con la nueva \"Fecha Estimada Entrega\"\n    return { json: { \n        ...item.json, \n        \"Fecha Estimada Entrega\": nuevaFechaEntrega \n    }};\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
