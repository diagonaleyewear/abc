        "jsCode": "try {\n  // 1. Verificar que exista un archivo binario en la entrada\n  if (!items[0] || !items[0].binary) {\n    throw new Error('No se encontró ningún dato binario en la entrada.');\n  }\n  const binaryKeys = Object.keys(items[0].binary);\n  if (binaryKeys.length === 0) {\n    throw new Error('El elemento de entrada no contiene datos binarios.');\n  }\n  const binaryPropertyName = binaryKeys[0];  // nombre de la propiedad binaria (ej: 'data')\n\n  // 2. Obtener el contenido binario (Buffer) del CSV\n  const fileBuffer = await this.helpers.getBinaryDataBuffer(0, binaryPropertyName);\n\n  // 3. Convertir el contenido binario a texto (asumiendo codificación UTF-8)\n  let content = fileBuffer.toString('utf8');\n\n  // 4. Reemplazar saltos de línea '\\n' por '\\r\\n' en todo el texto\n  //    - Primero normalizamos cualquier secuencia '\\r\\n' existente a un único '\\n'\n  content = content.replace(/\\r\\n/g, '\\n');\n  //    - Luego reemplazamos **todas** las ocurrencias de '\\n' por '\\r\\n'\n  content = content.replace(/\\n/g, '\\r\\n');\n\n  // 5. Convertir el texto modificado de vuelta a formato binario (Buffer)\n  const newFileBuffer = Buffer.from(content, 'utf8');\n\n  // 6. Preparar el nuevo nombre de archivo con el prefijo \"fixed_\"\n  const originalFileName = items[0].binary[binaryPropertyName].fileName || 'archivo.csv';\n  const fixedFileName = 'T' + originalFileName;\n\n  // 7. Conservar el tipo MIME original si existe, o usar 'text/csv' por defecto\n  const mimeType = items[0].binary[binaryPropertyName].mimeType || 'text/csv';\n\n  // 8. Construir el objeto binario de salida con el contenido corregido\n  const newBinaryData = {\n    data: newFileBuffer.toString('base64'),  // n8n requiere los datos binarios en base64\n    fileName: fixedFileName,\n    mimeType: mimeType\n  };\n\n  // 9. Devolver el archivo corregido en la estructura adecuada\n  return [{\n    json: {},  // Puede incluir datos JSON adicionales si es necesario\n    binary: {\n      [binaryPropertyName]: newBinaryData\n    }\n  }];\n\n} catch (error) {\n  // Manejo de errores: lanzar un error descriptivo si algo falla\n  throw new Error('Error procesando el archivo CSV: ' + error.message);\n}\n"
      },
