        "toRecipients": "pedidos.stars@diagonaleyewear.com",
        "subject": "Luxottica STARS - Transformado - SG",
        "bodyContent": "={{ \n    'Este Email parte del email:\\n\\t- TITULO: ' + $('Mensaje').item.json.subject +\n    '\\n\\t- FECHA: ' + \n    (() => {\n        // Obtener la fecha original en UTC\n        let fechaUTC = new Date($('Mensaje').item.json.receivedDateTime);\n\n        // Crear una nueva fecha en la zona horaria de Madrid\n        let fechaMadrid = new Intl.DateTimeFormat(\"es-ES\", { \n            timeZone: \"Europe/Madrid\",\n            weekday: \"short\", \n            day: \"2-digit\", \n            month: \"2-digit\", \n            year: \"numeric\",\n            hour: \"2-digit\",\n            minute: \"2-digit\",\n            hour12: false \n        }).format(fechaUTC);\n\n        return fechaMadrid;\n    })() \n}}\n",
        "additionalFields": {
          "attachments": {
            "attachments": [
              {
                "binaryPropertyName": "datoss"
              },
              {
                "binaryPropertyName": "datass"
              }
            ]
          }
        }
      },
